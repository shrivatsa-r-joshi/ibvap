# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Video source ---
# VIDEO_SOURCE = sample | webcam | rtsp
VIDEO_SOURCE=sample
SAMPLE_VIDEO_PATH=backend/sample_videos/demo_clip.mp4
RTSP_URL=

# --- Virtual fence line ---
# Two points x1,y1,x2,y2 as fractions of frame width/height (0-1), matching docs/schema.md bbox format.
FENCE_LINE_COORDS=0.1,0.6,0.9,0.6

# --- Alerts: SMS (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ALERT_SMS_TO=

# --- Alerts: Email (SendGrid) ---
SENDGRID_API_KEY=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# --- Backend ---
DATABASE_PATH=backend/app/db/events.db
WS_PORT=8000
